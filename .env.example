FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Strict
CORS_ORIGINS=http://localhost:8081,http://localhost:8082,http://127.0.0.1:8081,http://127.0.0.1:8082
TELEMETRY_STALE_SECONDS=120
MAX_LOAD_W=1000

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=TU_PASSWORD_REAL
MYSQL_DATABASE=energy_storage_iot

